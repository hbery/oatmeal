#!/bin/sh
# vim: ft=sh : ts=4 : sts=4 : sw=4 : et :
# Rustlang and Cargo package manager specific variables

export CARGO_HOME="${XDG_DATA_HOME:-"${HOME}/.local/share"}/cargo"
export CARGO_BIN="${CARGO_HOME}/bin"

case ":${PATH}:" in
    *":${CARGO_BIN}:"*) ;;
    *) export PATH="${CARGO_BIN}:${PATH}" ;;
esac
