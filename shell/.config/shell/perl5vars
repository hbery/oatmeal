#!/bin/sh
# vim: ft=sh : ts=4 : sts=4 : sw=4 : et :
# Perl environmental variables

export PERL_MY_HOME="${XDG_DATA_HOME:-"${HOME}/.local/share"}/perl"

export PERL_CPANM_HOME="${PERL_MY_HOME}/cpanminus"

case ":${PERL_LIB_LOCAL_ROOT}:" in
    *":${PERL_MY_HOME}:"*) ;;
    *) export PERL_LIB_LOCAL_ROOT="${PERL_LIB_LOCAL_ROOT}:${PERL_MY_HOME}" ;;
esac

for _env in "PERL5LIB" "PERLLIB"; do
    _eval="$(eval "printf '%s' \"\$${_env}\"")"
    case ":${_eval}:" in
        *":${PERL_MY_HOME}/lib/perl5:"*) ;;
        *) eval "export ${_env}=\"${PERL_MY_HOME}/lib/perl5:${_eval}\"" ;;
    esac
done

export PERL_MB_OPT="--install_base ${PERL_MY_HOME}"
export PERL_MM_OPT="INSTALL_BASE=${PERL_MY_HOME}"
export PERL_MY_BIN="${PERL_MY_HOME}/bin"

export CPAN_OPTS="-j ${PERL_MY_HOME}/cpan/CPAN/Config.pm"

export PERLBREW_ROOT="${PERL_MY_HOME}/perlbrew"
export PERLBREW_HOME="${XDG_CONFIG_HOME}/perlbrew"

# append to PATH
case ":${PATH}:" in
    *":${PERL_MY_BIN}:"*) ;;
    *) export PATH="${PERL_MY_BIN}:${PATH}" ;;
esac
