#!/bin/bash
# vim: ft=bash : ts=4 : sts=4 : sw=4 : et :

_getBatteryFn () {
    find /sys/class/power_supply -maxdepth -type d -name "*BAT*" -exec basename {} \; -quit
}

_getBatteryCapFn () {
    local _battery
    _battery="${1}"
    cat "/sys/class/power_supply/${_battery}/capacity"
}

_getBatteryStatFn () {
    local _battery
    _battery="${1}"
    cat "/sys/class/power_supply/${_battery}/status"
}

_mainFn () {
    local _battery
    _battery="$(_getBatteryFn)"

    if [[ -z "${_battery}" ]]; then
        printf "%s" "100"
        exit
    fi

    case "$1" in
        "cap")    _getBatteryCapFn "${_battery}"  ;;
        "status") _getBatteryStatFn "${_battery}" ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    _mainFn "${@:-}"
fi
