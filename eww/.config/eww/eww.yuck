;; vim: ft=lisp : ts=2 : sts=2 : sw=2 : et :

;; VARIABLES
(defvar vol_reveal false)
(defvar br_reveal false)
(defvar music_reveal false)
(defvar wifi_rev false)
(defvar ping_rev false)
(defvar time_rev false)


;; POLLING VARS
(defpoll clock_time :interval "10s" "date +\%H")
(defpoll clock_minute :interval "5s" "date +\%M")
(defpoll clock_date :interval "10h" "date '+%d/%m'")
(defpoll volume_percent
         :interval "3s"
         "amixer -D pipewire sget Master | awk -F'[][]' '/Left:/ { sub(\"%\", \"\", $2); print $2 }'")
(defpoll mic_percent
         :interval "3s"
         "amixer -D pipewire sget Capture | awk -F'[][]' '/Left:/ { sub(\"%\", \"\", $2); print $2 }'")
(defpoll brightness_percent
         :interval "5s"
         "brightnessctl -m | awk -F, '{ sub(\"%\", \"\", $4); print $4 }'")

(defpoll battery :interval "15s" "scripts/battery cap")
(defpoll battery_status :interval "1m" "scripts/battery status")
(defpoll memory :interval "15s" "scripts/memory percent")
(defpoll memory_used :interval "2m" "scripts/memory used")
(defpoll memory_total :interval "2m" "scripts/memory total")
(defpoll memory_avail :interval "2m" "scripts/memory avail")

(defpoll wlan_colour :interval "1m" "scripts/wifi colour")
(defpoll wlan_essid :interval "1m" "scripts/wifi essid")
(defpoll wlan_icon :interval "1m" "scripts/wifi icon")

(defpoll ping_lat :interval "15s" "scripts/ping instant")

(defpoll song :interval "2s" "scripts/music-info --song")
(defpoll song_artist :interval "2s" "scripts/music-info --artist")
(defpoll current_status :interval "1s" "scripts/music-info --time")
(defpoll song_status :interval "2s" "scripts/music-info --status")
(defpoll cover_art :interval "2s" "scripts/music-info --cover")

(defpoll calendar_day :interval "20h" "date '+%d'")
(defpoll calendar_year :interval "20h" "date '+%Y'")

(defpoll current_window_title :interval "1s" "hyprctl -j activewindow | jq -r '.title // \"\"'")

(deflisten workspace "scripts/workspace")


;; WIDGETS
(defwidget closer []
  (eventbox
    :onclick "scripts/pop close"
    )
  )


(defwidget active_window []
  (box
    :class "module-2"
    :orientation "h"
    :space-evenly false
    :vexpand false
    :hexpand false
    (label
      :class "active_window_title"
      :limit-width 50
      :show-truncated true
      :wrap false
      :text current_window_title
      )
    )
  )


(defwidget wifi []
  (eventbox
    :onhover "${EWW_CMD} update wifi_rev=true"
    :onhoverlost "${EWW_CMD} update wifi_rev=false"
    (box
      :vexpand false
      :hexpand false
      :space-evenly false
      (label
        :wrap false
        :limit-width 12
        :style "color: ${wlan_colour}; font-size: 22;"
        :text wlan_icon
        )
      (revealer
        :transition "slideright"
        :reveal wifi_rev
        :duration "350ms"
        (label
          :class "module_essid"
          :text wlan_essid
          )
        )
      )
    )
  )


(defwidget workspaces []
  (literal :content workspace))


(defwidget bat []
  (box
    :class "bat_module"
    :vexpand false
    :hexpand false
    (circular-progress
      :value battery
      :class "batbar"
      :thickness 5
      (button
        :class "iconbat"
        :onclick "scripts/pop system"
        :tooltip "battery on ${battery}%"
        (label
          :limit-width 2
          :show-truncated false
          :wrap false
          :text " "
          )
        )
      )
    )
  )


(defwidget mem []
  (box
    :class "mem_module"
    :vexpand false
    :hexpand false
    (circular-progress
      :value memory
      :class "membar"
      :thickness 5
      (button
        :class "iconmem"
        :tooltip "using ${memory}% ram"
        :onclick "scripts/pop system"
        (label
          :limit-width 2
          :show-truncated false
          :wrap false
          :text " "
          )
        )
      )
    )
  )

(defwidget ping []
  (eventbox
    :onhover "${EWW_CMD} update ping_rev=true"
    :onhoverlost "${EWW_CMD} update ping_rev=false"
    (box
      :class "ping_module"
      :vexpand false
      :hexpand false
      :space-evenly false
      (label
        :class "iconping"
        :limit-width 1
        :show-truncated false
        :wrap false
        :text "󱕌 "
        )
      (revealer
        :transition "slideright"
        :reveal ping_rev
        :duration "350ms"
        (label
          :class "module_ping"
          :show-truncated false
          :wrap false
          :text "${ping_lat} ms"
          )
        )
      )
    )
  )

(defwidget sep []
  (box
    :class "module-2"
    :vexpand false
    :hexpand false
    (label
      :class "separ"
      :text "|"
      )
    )
  )

(defwidget sys_tray []
  (box
    :class "systray"
    :vexpand false
    :hexpand true
    (systray
      :orientation "h"
      :spacing 2
      :icon-size 20
      :space-evenly true
      :prepend-new true
      )
    )
   )


(defwidget clock_module []
  (eventbox
    :onhover "${EWW_CMD} update time_rev=true"
    :onhoverlost "${EWW_CMD} update time_rev=false"
    (box
      :class "module"
      :space-evenly false
      :orientation "h"
      :spacing "3"
      (label
        :class "clock_time_class"
        :text clock_time)
      (label
        :class "clock_time_sep"
        :text ":")
      (label
        :class "clock_minute_class"
        :text clock_minute)
      (revealer
        :transition "slideleft"
        :reveal time_rev
        :duration "350ms"
        (button
          :class "clock_date_class"
          :onclick "scripts/pop calendar" clock_date)
        )
      )
    )
  )


(defwidget volume []
  (eventbox
    :onhover "${EWW_CMD} update vol_reveal=true"
    :onhoverlost "${EWW_CMD} update vol_reveal=false"
    (box
      :class "module-2"
      :space-evenly false
      :orientation "h"
      :spacing "3"
      (button
        :class "volume_icon"
        :onclick "scripts/pop audio"
        :onrightclick "kitty --detach --hold --override 'confirm_os_window_close 0' wiremix" " ")
      (revealer
        :transition "slideleft"
        :reveal vol_reveal
        :duration "350ms"
        (scale
          :class "volbar"
          :value volume_percent
          :orientation "h"
          :tooltip "${volume_percent}%"
          :max 100
          :min 0
          :onchange "amixer -D pipewire sset Master {}%"
          )
        )
      )
    )
  )


(defwidget bright []
  (eventbox
    :onhover "${EWW_CMD} update br_reveal=true"
    :onhoverlost "${EWW_CMD} update br_reveal=false"
    (box
      :class "module-2"
      :space-evenly false
      :orientation "h"
      :spacing "3"
      (label
        :class "bright_icon"
        :text " "
        :tooltip "brightness")
      (revealer
        :transition "slideleft"
        :reveal br_reveal
        :duration "350ms"
        (scale
          :class "brightbar"
          :value brightness_percent
          :orientation "h"
          :tooltip "${brightness_percent}%"
          :max 100
          :min 0
          :onchange "brightnessctl set {}%"
          )
        )
      )
    )
  )


(defwidget music []
  (eventbox
    :onhover "${EWW_CMD} update music_reveal=true"
    :onhoverlost "${EWW_CMD} update music_reveal=false"
    (box
      :class "module-2"
      :orientation "h"
      :space-evenly false
      :vexpand false
      :hexpand false
      (box
        :class "song_cover_art"
        :vexpand "false"
        :hexpand "false"
        :style "background-image: url('${cover_art}');")
      (button
        :class "song"
        :onclick "scripts/pop music" song)
      (revealer
        :transition "slideright"
        :reveal music_reveal
        :duration "350ms"
        (box
          :vexpand false
          :hexpand false
          :orientation "h"
          (button
            :class "song_btn_prev"
            :onclick "scripts/music-info --prev" "")
          (button
            :class "song_btn_play"
            :onclick "scripts/music-info --toggle" song_status)
          (button
            :class "song_btn_next"
            :onclick "scripts/music-info --next" "")
          )
        )
      )
    )
  )


(defwidget left []
  (box
    :class "left_modules"
    :space-evenly false
    :orientation "h"
    :halign "end"
    (sys_tray)
    (sep)
    (bright)
    (volume)
    (wifi)
    (ping)
    (sep)
    (bat)
    (mem)
    (sep)
    (clock_module)
    )
  )


(defwidget right []
  (box
    :orientation "h"
    :space-evenly false
    :halign "start"
    :class "right_modules"
    (workspaces)
    (sep)
    (active_window)
    )
  )


(defwidget center []
  (box
    :class "center_modules"
    :space-evenly false
    :orientation "h"
    :halign "center"
    (music)
    )
  )


(defwidget bar_1 []
  (box
    :class "bar_class"
    :orientation "h"
    (right)
    (center)
    (left)
    )
  )


(defwindow bar
  :geometry (geometry
    :x "0%"
    :y "5px"
    :width "99%"
    :height "30px"
    :anchor "top center")
  :stacking "fg"
  :windowtype "dock"
  :monitor 0
  (bar_1)
  )


(defwidget system []
  (box :class "sys_win" :orientation "v" :space-evenly "false" :hexpand "false" :vexpand "false" :spacing 0
    (box :class "sys_bat_box" :orientation "h" :space-evenly "false"
      (circular-progress
        :value battery
        :class "sys_bat"
        :thickness 9
        (label
          :text " "
          :class "sys_icon_bat"
          :limit-width 2
          :show-truncated false
          :wrap false
          :halign "center"
          :valign "center")
        )
      (box
        :orientation "v"
        :space-evenly false
        :spacing 0
        :hexpand false
        :vexpand false
        (label
          :text "battery"
          :halign "start"
          :class "sys_text_bat"
          :limit-width 9
          :show-truncated false
          :wrap false)
        (label
          :text "${battery}%"
          :halign "start"
          :class "sys_text_bat_sub"
          :limit-width 22
          :show-truncated false
          :wrap false)
        (label
          :text "${battery_status}"
          :halign "start"
          :class "sys_text_bat_sub"
          :limit-width 22
          :show-truncated false
          :wrap false)
        )
      )
    (label
      :class "sys_sep"
      :text ""
      :halign "center")
    (box
      :class "sys_mem_box"
      :orientation "h"
      :space-evenly false
      :halign "start"
      (circular-progress
        :class "sys_mem"
        :value memory
        :thickness 9
        (label
          :text " "
          :class "sys_icon_mem"
          :limit-width 2
          :show-truncated false
          :wrap false
          :angle 0.0)
        )
      (box
        :space-evenly false
        :orientation "v"
        :spacing 0
        :hexpand false
        :vexpand false
        (label
          :class "sys_text_mem"
          :text memory
          :halign "start"
          :limit-width 9
          :show-truncated false
          :wrap false)
        (label
          :class "sys_text_mem_sub"
          :text "${memory_used} | ${memory_total} "
          :halign "start"
          :limit-width 22
          :show-truncated false
          :wrap false)
        (label
          :class "sys_text_mem_sub"
          :text "${memory_avail} free"
          :halign "start"
          :limit-width 22
          :show-truncated false
          :wrap false)
        )
      )
    )
  )


(defwidget cal []
  (box
    :class "cal"
    :orientation "v"
    (box
      :class "cal-in"
      (calendar
        :class "cal"
        :day calendar_day
        :year calendar_year)
      )
    )
  )


(defwindow calendar
  :geometry (geometry
    :x "0.5%"
    :y "60px"
    :anchor "top right"
    :width "270px"
    :height "60px")
  :stacking "fg"
  (cal)
  )


(defwidget audio []
  (box
    :class "audio-box"
    :orientation "v"
    :space-evenly false
    :vexpand false
    :hexpand false
    (box
      :halign "v"
      :space-evenly false
      :hexpand false
      :vexpand false
      (box
        :class "speaker_icon"
        :orientation "v")
      (box
        :orientation "v"
        :halign "center"
        :vexpand false
        :hexpand false
        (label
          :class "speaker_text"
          :text "speaker"
          :valign "center"
          :halign "left")
        (box
          :class "speaker_bar"
          :halign "center"
          :vexpand false
          :hexpand false
          (scale
            :value volume_percent
            :space-evenly false
            :orientation "h"
            :onchange "amixer -D pipewire sset Master {}%"
            :tooltip "volume on ${volume_percent}%"
            :max 100
            :min 0)
          )
        )
      )
    (label
      :class "audio_sep"
      :text ""
      :halign "center")
    (box
      :halign "v"
      :space-evenly false
      :hexpand false
      :vexpand false
      (box
        :class "mic_icon"
        :orientation "v")
      (box
        :orientation "v"
        :halign "center"
        :vexpand false
        :hexpand false
        (label
          :class "mic_text"
          :valign "center"
          :halign "left"
          :text "mic")
        (box
          :class "mic_bar"
          :halign "center"
          :vexpand false
          :hexpand false
          (scale
            :value mic_percent
            :space-evenly false
            :orientation "h"
            :tooltip "mic on ${mic_percent}%"
            :onchange "amixer -D pipewire sset Capture {}%"
            :max 100
            :min 0)
          )
        )
      )
    )
  )


(defwindow audio_ctl
  :geometry (geometry
    :x "0.5%"
    :y "60px"
    :anchor "top right"
    :width "280px"
    :height "60px")
  :stacking "fg"
  (audio)
  )


(defwindow system
  :geometry (geometry
    :x "0.5%"
    :y "60px"
    :anchor "top right"
    :width "290px"
    :height "120px")
  :stacking "fg"
  (system)
  )


;;  MUSIC
(defwidget music_pop []
  (box
    :class "music_pop"
    :orientation "h"
    :space-evenly false
    :vexpand false
    :hexpand false
    (box
      :class "music_cover_art"
      :vexpand false
      :hexpand false
      :style "background-image: url('${cover_art}');")
    (box
      :space-evenly "false"
      :spacing 20
      :orientation "v"
      :vexpand false
      :hexpand false
      (label
        :class "music"
        :halign "center"
        :wrap "true"
        :limit-width 13
        :text song)
      (label
        :halign "center"
        :class "music_artist"
        :wrap true
        :limit-width 15
        :text song_artist)
      (box
        :orientation "h"
        :spacing 15
        :halign "center"
        :space-evenly false
        :vexpand false
        :hexpand false
        (button
          :class "music_btn_prev"
          :onclick "scripts/music-info --prev" "")
        (button
          :class "music_btn_play"
          :onclick "scripts/music-info --toggle" song_status)
        (button
          :class "music_btn_next"
          :onclick "scripts/music-info --next" ""))
      (box
        :class "music_bar"
        :space-evenly false
        :vexpand false
        :hexpand false
        :halign "center"
        (scale
          :onscroll "mpc -q seek {}"
          :min 0
          :active "true"
          :max 100
          :value current_status)
        )
      )
    )
  )


(defwindow music_win
  :geometry (geometry
    :x "0"
    :y "7%"
    :width 428
    :height 104
    :anchor "top center")
  :stacking "fg"
  :focusable "false"
  (music_pop)
  )


(defwindow popup_closer
  :geometry (geometry
    :width "100%"
    :height "100%")
  :stacking "fg"
  :focusable false
  (closer)
  )
